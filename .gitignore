# --- dependencies ---------------------------------------------------------
node_modules/

# --- credentials and environment ------------------------------------------
# A project-level .npmrc holds an auth token. Never commit one.
.npmrc
.env
.env.*
!.env.example

# --- build and test output ------------------------------------------------
# Rendered PDFs, rasterised pages and diff images from the experiments.
# Anchored because the root test output and Kami comparison output are generated
# by different commands and documented separately below.
/out/
*.pdf
# npm pack writes the tarball into the project root.
*.tgz
coverage/
.eslintcache
/.demo-dist/
/dist/
/.wrangler/

# Development notes are kept locally; durable public documentation lives in
# README.md, FEATURES.md, COMPARISON.md, COMPATIBILITY.md and CONTRIBUTING.md.
/notes/

# --- third-party comparison assets ----------------------------------------
# Third-party fonts and comparison artifacts are reproducible and stay local.
# The compact results summary remains tracked in kami/COMPARISON.md.
kami/fonts/
kami/out/

# --- browser downloads ----------------------------------------------------
# Chrome for Testing lands here when @puppeteer/browsers runs from the root.
chrome/
.cache/

# --- logs -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*

# --- editors and OS -------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- local, machine-specific tool settings --------------------------------
.claude/settings.local.json
.agents/
