{
  "name": "garri",
  "version": "0.1.0-alpha.3",
  "license": "MIT",
  "type": "module",
  "description": "A browser-native document compiler that turns rendered HTML into programmable native PDFs without headless Chromium or a server",
  "keywords": [
    "pdf",
    "html-to-pdf",
    "html2pdf",
    "browser",
    "client-side",
    "clientside",
    "print",
    "pagination",
    "css-paged-media",
    "acroform",
    "svg-to-pdf",
    "no-server"
  ],
  "files": [
    "src",
    "dist",
    "README.md",
    "FEATURES.md",
    "COMPARISON.md",
    "COMPATIBILITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/garri.d.mts",
      "import": "./dist/garri.mjs",
      "require": "./dist/garri.cjs",
      "default": "./dist/garri.mjs"
    },
    "./bundle": "./dist/garri.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "peerDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "peerDependenciesMeta": {
    "pdf-lib": {
      "optional": false
    },
    "@pdf-lib/fontkit": {
      "optional": false
    }
  },
  "devDependencies": {
    "pdfjs-dist": "^6.2.108",
    "puppeteer": "^25.9.0",
    "regenerator-runtime": "^0.14.1"
  },
  "scripts": {
    "build": "node build.js",
    "prepack": "node build.js",
    "test": "node experiments/entry-point.js",
    "test:bundle": "node build.js && node experiments/entry-point.js --load=iife && node experiments/entry-point.js --load=esm && node experiments/entry-point.js --load=standalone",
    "test:furniture": "node experiments/furniture.js",
    "test:named-pages": "node experiments/named-pages.js",
    "test:scale": "node experiments/scale.js",
    "test:versions": "node experiments/version-sweep.js",
    "demo": "npm run build && node serve.js",
    "demo:build": "node scripts/build-demo.js",
    "demo:deploy": "npm run build && npm run demo:build && wrangler deploy"
  },
  "main": "./dist/garri.mjs",
  "browser": "./dist/garri.js",
  "unpkg": "./dist/garri.js",
  "jsdelivr": "./dist/garri.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitaldrreamer/garri.git"
  },
  "homepage": "https://github.com/digitaldrreamer/garri#readme",
  "bugs": {
    "url": "https://github.com/digitaldrreamer/garri/issues"
  },
  "types": "./dist/garri.d.ts"
}
